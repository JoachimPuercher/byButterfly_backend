# Copy to .env for local development. .env is gitignored.
# Production reads these from the platform environment, not from a file.

# Which settings module to load: core.settings.dev | core.settings.prod
DJANGO_SETTINGS_MODULE=core.settings.dev

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# PostgreSQL. HOST is "db" inside docker-compose, "localhost" when Django runs on the host.
POSTGRES_DB=bybutterfly
POSTGRES_USER=bybutterfly
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production only, comma-separated
ALLOWED_HOSTS=
LOG_LEVEL=INFO
