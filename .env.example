# Copy to .env for local development. .env is gitignored.
# Production (Railway) reads these from the service variables, not from a file.


# Select env file for local testing or prod database
ENV_FILE=the env file

# --- Django ---

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-with-secrets.token_urlsafe
# Prod only, comma-separated: api.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Prod only: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Django settings for building dev/prod
DJANGO_SETTINGS_MODULE=core.settings.dev

# --- PostgreSQL ---
# PostgreSQL. The db container creates database and user from these on first start;
# Django connects with the same values. HOST is "db" inside docker-compose,
# "localhost" when Django runs on the host against the mapped port.
# Local: db = docker-compose service. Railway from the laptop: TCP proxy host + port.
POSTGRES_DB=bybutterfly
POSTGRES_USER=bybutterfly
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# prefer = local Docker db and Railway private network, require = Railway TCP proxy
POSTGRES_SSLMODE=prefer
# Prod only: seconds a connection is reused across requests
CONN_MAX_AGE=60

# --- Background workers (django-rq + Redis) ---
# True locally (web + worker + redis), False on Railway in phase 1
# Redis (task queue broker). REDIS_PASSWORD is read by the redis container,
# REDIS_URL by Django. Keep both in sync: redis://:<REDIS_PASSWORD>@redis:6379/0
# On Railway the Redis plugin provides REDIS_URL directly.
DEPLOY_BACKGROUND_WORKERS=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_LOCATION=redis://redis:6379/1
REDIS_URL=concatenating
# Free-form secret, docker-compose starts Redis with --requirepass on it
REDIS_PASSWORD=change-me-generate-with-secrets.token_urlsafe
# Job timeout and result retention in seconds
RQ_DEFAULT_TIMEOUT=600
RQ_RESULT_TTL=3600
# Optional: job limits in seconds (defaults 600 / 3600)

# Django super user
DJANGO_SUPERUSER_USERNAME=jochpue
DJANGO_SUPERUSER_PASSWORD=Papaistsuper11!!


CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=jenymia_cacheDJANGO_SUPERUSER_EMAIL=jochpue@gmail.com
# --- Media ---------------------------------------------------------------
# Base URL the media files are served from. The database stores relative keys only;
# this URL is prefixed when serializing. No trailing slash.
JENYMIA_MEDIA_BASE_URL=http://localhost:8000/media
# Directory for audio tracks extracted from videos (relative to the project root).
JENYMIA_AUDIO_DIR=.media/audio

# --- Ingest --------------------------------------------------------------
# Maximum length of a source video in seconds (2400 = 40 minutes).
# Longer videos are rejected instead of being transcribed.
MAX_VIDEO_DURATION_SECONDS=2400
# Total number of attempts for a failing ingest job before it is marked as failed.
INGEST_MAX_ATTEMPTS=5

# --- Transcription -------------------------------------------------------
# Where transcription runs: "local" = faster-whisper in the same process.
TRANSCRIBE_BACKEND=local
# Whisper model size. Larger is more accurate but slower and needs more memory.
WHISPER_MODEL=large-v3
# Compute device: "cpu" or "cuda".
WHISPER_DEVICE=cpu
# Quantization of the model weights. Match it to WHISPER_DEVICE:
# "int8" for CPU, "float16" for CUDA.
WHISPER_COMPUTE_TYPE=int8

# Choose "gemini" | "claude"
USE_LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
