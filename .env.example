# Copy to .env for local development. .env is gitignored.
# Production (Railway) reads these from the service variables, not from a file.

# Which settings module to load: core.settings.dev | core.settings.prod
DJANGO_SETTINGS_MODULE=core.settings.dev

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# PostgreSQL. The db container creates database and user from these on first start;
# Django connects with the same values. HOST is "db" inside docker-compose,
# "localhost" when Django runs on the host against the mapped port.
POSTGRES_DB=bybutterfly
POSTGRES_USER=bybutterfly
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (task queue broker). REDIS_PASSWORD is read by the redis container,
# REDIS_URL by Django. Keep both in sync: redis://:<REDIS_PASSWORD>@redis:6379/0
# On Railway the Redis plugin provides REDIS_URL directly.
REDIS_PASSWORD=
REDIS_URL=redis://:@redis:6379/0

# Optional: job limits in seconds (defaults 600 / 3600)
# RQ_DEFAULT_TIMEOUT=600
# RQ_RESULT_TTL=3600

# Production only, comma-separated
ALLOWED_HOSTS=
LOG_LEVEL=INFO
